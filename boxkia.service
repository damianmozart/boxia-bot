[Unit]
Description=Boxkia treasure hunt bot (multi-account)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/boxkia-bot
Environment=TZ=Asia/Jakarta
ExecStart=/usr/bin/node /home/user/boxkia-bot/bot.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
